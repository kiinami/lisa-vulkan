<rendergraph output="color">
    <resource id="color" type="final"/>
    <resource id="depth" type="depth"/>

    <pass id="forward" type="forward">
        <output id="color" ref="color" usage="ColorAttachmentWrite"/>
        <output id="depth" ref="depth" usage="DepthStencilAttachmentWrite"/>
    </pass>
</rendergraph>
