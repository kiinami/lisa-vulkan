# ─── Build type ─────────────────────────────────────────────────────────────

option('build_shared',
       type : 'boolean',
       value : false,
       description : 'Build a shared library instead of a static one',
)

option('strict_warnings',
       type : 'boolean',
       value : false,
       description : 'Enable strict compiler warnings (-Wall -Wextra … / /W4)',
)

option('use_std_expected',
       type : 'boolean',
       value : false,
       description : 'Use std::expected instead of the built-in Result type (requires C++23)',
)

# ─── Format backends ────────────────────────────────────────────────────────

option('all_formats',
       type : 'boolean',
       value : false,
       description : 'Enable all supported serialization format backends',
)

option('json',
       type : 'boolean',
       value : true,
       description : 'Enable JSON support (via yyjson)',
)

option('avro',
       type : 'boolean',
       value : false,
       description : 'Enable AVRO support (requires avro-c and jansson)',
)

option('bson',
       type : 'boolean',
       value : false,
       description : 'Enable BSON support (requires libbson-1.0)',
)

option('capnproto',
       type : 'boolean',
       value : false,
       description : 'Enable Capn Proto support (requires kj, capnp, capnpc, kj-gzip)',
)

option('cbor',
       type : 'boolean',
       value : false,
       description : 'Enable CBOR support (requires jsoncons)',
)

option('cereal',
       type : 'boolean',
       value : false,
       description : 'Enable Cereal support (requires cereal)',
)

option('csv',
       type : 'boolean',
       value : false,
       description : 'Enable CSV support (requires Arrow)',
)

option('flexbuffers',
       type : 'boolean',
       value : false,
       description : 'Enable FlexBuffers support (requires flatbuffers)',
)

option('msgpack',
       type : 'boolean',
       value : false,
       description : 'Enable MessagePack support (requires msgpack-c)',
)

option('parquet',
       type : 'boolean',
       value : false,
       description : 'Enable Parquet support (requires Arrow and Parquet)',
)

option('xml',
       type : 'boolean',
       value : false,
       description : 'Enable XML support (requires pugixml)',
)

option('toml',
       type : 'boolean',
       value : false,
       description : 'Enable TOML support (requires tomlplusplus)',
)

option('ubjson',
       type : 'boolean',
       value : false,
       description : 'Enable UBJSON support (requires jsoncons)',
)

option('yaml',
       type : 'boolean',
       value : false,
       description : 'Enable YAML support (requires yaml-cpp)',
)

option('yas',
       type : 'boolean',
       value : false,
       description : 'Enable YAS support (header-only; set yas_include_dir if not on system path)',
)

option('boost_serialization',
       type : 'boolean',
       value : false,
       description : 'Enable Boost.Serialization support (requires Boost::serialization)',
)

# ─── Misc ───────────────────────────────────────────────────────────────────

option('yas_include_dir',
       type : 'string',
       value : '',
       description : 'Path to the YAS include directory (only needed if YAS is not on the system include path)',
)