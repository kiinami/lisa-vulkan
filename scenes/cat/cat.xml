<scene xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="../scene.xsd">
    <entity name="cat">
        <transform>
            <translate value="0, 0, 0"/>
            <scale value="10.0"/>
        </transform>
        <mesh type="obj" path="models/cat.obj"/>
        <texture diffuse="textures/concrete_cat_statue_diff_1k.jpg"
                 roughness="textures/concrete_cat_statue_rough_1k.exr"
                 metallic="textures/concrete_cat_statue_metal_1k.exr"
                 normal="textures/concrete_cat_statue_nor_gl_1k.exr"
        />
    </entity>

    <entity name="main_camera">
        <transform>
            <lookat origin="0, 1, 4" target="0, 1, 0" up="0, 1, 0"/>
        </transform>
        <camera/>
    </entity>

    <entity name="sun_light">
        <transform>
            <lookat origin="0, 0, 0" target="0, -1, -1" up="0, 1, 0"/>
        </transform>
        <directional_light color="1.0, 0.9, 0.8" intensity="3"/>
    </entity>
</scene>
