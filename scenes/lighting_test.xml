<scene>
    <!-- Central Objects -->
    <entity name="monkey_center">
        <transform>
            <translate value="0, 0, 0"/>
        </transform>
        <mesh type="obj" path="./models/suzanne.obj"/>
        <texture path="./textures/suzanne0.ktx"/>
    </entity>

    <entity name="monkey_left">
        <transform>
            <translate value="-3, 0, 0"/>
            <rotate axis="0, 1, 0" angle="45"/>
        </transform>
        <mesh type="obj" path="./models/suzanne.obj"/>
        <texture path="./textures/suzanne1.ktx"/>
    </entity>

    <entity name="monkey_right">
        <transform>
            <translate value="3, 0, 0"/>
            <rotate axis="0, 1, 0" angle="-45"/>
        </transform>
        <mesh type="obj" path="./models/suzanne.obj"/>
        <texture path="./textures/suzanne2.ktx"/>
    </entity>

    <!-- Camera -->
    <entity name="main_camera">
        <transform>
            <lookat origin="0, 2, 8" target="0, 0, 0" up="0, 1, 0"/>
        </transform>
        <camera/>
    </entity>

    <!-- Lighting Setup -->

    <!-- Main Directional Light (Sun/Moon) -->
    <entity name="sun_light">
        <transform>
            <lookat origin="0, 0, 0" target="-1, -1, -1" up="0, 1, 0"/>
        </transform>
        <directional_light color="1.0, 0.9, 0.8" intensity="1.5"/>
    </entity>

    <!-- Red Point Light on the left -->
    <entity name="red_point_light">
        <transform>
            <translate value="-3, 1, 2"/>
        </transform>
        <point_light color="1.0, 0.1, 0.1" intensity="50.0" attenuation="1.0" radius="10.0"/>
    </entity>

    <!-- Blue Point Light on the right -->
    <entity name="blue_point_light">
        <transform>
            <translate value="3, -1, 2"/>
        </transform>
        <point_light color="0.1, 0.1, 1.0" intensity="50.0" attenuation="1.0" radius="10.0"/>
    </entity>

    <!-- Green Point Light from above/behind -->
    <entity name="green_point_light">
        <transform>
            <translate value="0, 3, -2"/>
        </transform>
        <point_light color="0.1, 1.0, 0.1" intensity="30.0" attenuation="1.0" radius="15.0"/>
    </entity>
</scene>
