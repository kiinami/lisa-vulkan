<scene xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="../scene.xsd">
    <entity name="main_camera">
        <transform>
            <lookat origin="0.0, 0.8, 1.8" target="0.0, 0.18, 0.0" up="0, 1, 0"/>
        </transform>
        <camera fov="16"/>
    </entity>

    <entity name="tower">
        <transform>
            <translate value="0 0 0"/>
        </transform>
        <mesh path="models/tower.obj"/>
        <material albedo="0.2 0.12 0.08" metallic="0.0" roughness="0.8"/>
    </entity>

    <entity name="bridge">
        <transform>
            <translate value="0 0 0"/>
        </transform>
        <mesh path="models/bridge.obj"/>
        <material albedo="0.2 0.12 0.08" metallic="0.0" roughness="0.8"/>
    </entity>

    <entity name="floor">
        <transform>
            <translate value="0 0 0"/>
        </transform>
        <mesh path="models/floor.obj"/>
        <material albedo="0.0 0.8 0.2" metallic="0.0" roughness="0.8"/>
    </entity>

    <entity name="tree">
        <transform>
            <translate value="0 0 0"/>
        </transform>
        <mesh path="models/tree.obj"/>
        <material albedo="1.0 0.0 0.0" metallic="0.0" roughness="0.8"/>
    </entity>

    <entity name="river">
        <transform>
            <translate value="0 0 0"/>
        </transform>
        <mesh path="models/river.obj"/>
        <material albedo="0.0 0.02 1.0" metallic="0.5" roughness="0.2"/>
    </entity>

    <entity name="ambient_light">
        <transform>
            <translate value="0 0 0"/>
        </transform>
        <ambient_light color="1 1 1" intensity="0.1"/>
    </entity>

    <entity name="light">
        <transform>
            <translate value="-0.25 0.5 0.5"/>
        </transform>
        <point_light color="0.8 0.5 0.5" intensity="20" attenuation="0.1" radius="2" cast_shadows="true"/>
    </entity>
</scene>
