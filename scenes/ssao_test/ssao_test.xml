<scene xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="../scene.xsd">
    <entity name="cat">
        <transform>
            <translate value="0, 0, 0"/>
            <scale value="10.0"/>
        </transform>
        <mesh path="models/cat.obj"/>
    </entity>

    <entity name="main_camera">
        <transform>
            <lookat origin="0, 1, 4" target="0, 1, 0" up="0, 1, 0"/>
        </transform>
        <camera/>
    </entity>

    <entity name="ambient_light">
        <ambient_light color="1.0, 0.9, 0.8" intensity="1"/>
    </entity>
</scene>
