<scene xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="../scene.xsd">
    <entity name="sphere1">
        <transform>
            <translate value="3, 0, 0"/>
        </transform>
        <mesh path="models/sphere.obj"/>
        <material albedo="0.5 0.0 0.0" roughness="0.05" metallic="0.0"/>
    </entity>
    <entity name="sphere2">
        <transform>
            <translate value="1, 0, 0"/>
        </transform>
        <mesh path="models/sphere.obj"/>
        <material albedo="0.5 0.0 0.0" roughness="1.0" metallic="0.0"/>
    </entity>
    <entity name="sphere3">
        <transform>
            <translate value="-1, 0, 0"/>
        </transform>
        <mesh path="models/sphere.obj"/>
        <material albedo="0.5 0.0 0.0" roughness="0.05" metallic="1.0"/>
    </entity>
    <entity name="sphere4">
        <transform>
            <translate value="-3, 0, 0"/>
        </transform>
        <mesh path="models/sphere.obj"/>
        <material albedo="0.5 0.0 0.0" roughness="1" metallic="1"/>
    </entity>
    <entity name="sun_light">
        <transform>
            <lookat origin="0, 0, 0" target="0, -1, -1" up="0, 1, 0"/>
        </transform>
        <directional_light color="0.6 0.2 0.2" intensity="100.0"/>
    </entity>
    <entity name="main_camera">
        <transform>
            <lookat origin="0, 2, 10" target="0, 0, 0" up="0, 1, 0"/>
        </transform>
        <camera/>
    </entity>
</scene>